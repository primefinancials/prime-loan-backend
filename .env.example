# Prime Loan V2 Environment Configuration

# Database
MONGODB_URI=mongodb://localhost:27017/prime-finance
REDIS_URL=redis://localhost:6379

OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
OPAY_PUBLIC_KEY=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Features
FEATURE_LEDGER=true
FEATURE_AUTO_APPROVAL=true
FEATURE_OCR=true

# Polling Configuration
POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=100
REFUND_TIMEOUT_MS=86400000

# Loan Configuration
LOAN_AUTO_APPROVAL_MAX_KOBO=5000000
LOAN_PENALTY_PCT_PER_DAY=1
AUTO_DEBIT_RETRY_SCHEDULE="3600000,21600000,86400000"

# Provider Configuration (VFD)
CUSTOMER_KEY=your_vfd_customer_key
CUSTOMER_SECRET=your_vfd_customer_secret
BASE_URL=https://api.vfd.com
AUTH_URL=https://auth.vfd.com

# Storage (S3)
S3_BUCKET=prime-finance-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key

# Email Configuration
EMAIL_USERNAME=your_email@domain.com
EMAIL_PASSWORD=your_email_password
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT_NUMBER=465

# Security
CRYPTOJS_KEY=your_encryption_key
ACCESS_TOKEN_SECRET=your_jwt_access_secret
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret

# Database Configuration
DB_URL=mongodb://localhost:27017/prime-finance
DATABASE_NAME=prime-finance
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_DIRECTORY=./logs

# ================================
# V2 Integration - PayBeta.ng
# Docs: https://docs.paybeta.ng/
# Console: https://console.paybeta.ng/merchant/settings
# ================================
PAYBETA_API_KEY=your_paybeta_api_key
PAYBETA_API_URL=https://api.paybeta.ng/v2

# ================================
# V2 Integration - Mono (Direct Debit)
# DirectPay product required
# ================================
MONO_SECRET_KEY=live_sk_xxxx
MONO_PUBLIC_KEY=live_pk_xxxx
MONO_WEBHOOK_SECRET=your_mono_webhook_secret

# ================================
# V2 Integration - Voice Call Provider (Termii)
# Signup: https://accounts.termii.com/#/register
# Docs: https://developers.termii.com/voice-call
# ================================
VOICE_CALL_PROVIDER=termii
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=PrimeFinance

# Optional: Plivo (fallback)
# PLIVO_AUTH_ID=your_plivo_auth_id
# PLIVO_AUTH_TOKEN=your_plivo_auth_token
# PLIVO_FROM_NUMBER=+234xxxxxxxxxx

# ================================
# V2 Integration - Frontend URL (for referral links)
# ================================
FRONTEND_URL=https://primefinance.live

# ================================
# V3 Integration - Flutterwave (Bill Payments)
# Docs: https://developer.flutterwave.com/reference
# ================================
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx

# ================================
# V3 Integration - Cloudinary (Media Uploads)
# Docs: https://cloudinary.com/documentation
# ================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ================================
# V3 Integration - Africa's Talking (Voice Calls - Fallback)
# Docs: https://africastalking.com/docs/voice
# ================================
AT_USERNAME=your_africastalking_username
AT_API_KEY=your_africastalking_api_key
AT_VOICE_CALLBACK_URL=https://your-backend.com/api/webhooks/at-voice
AT_CALL_FROM=+234xxxxxxxxxx

# ================================
# V3 Integration - Twilio (SMS & Voice - Legacy)
# Docs: https://www.twilio.com/docs
# ================================
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ================================
# Environment
# ================================
ENVIRONMENT=production
ENV=production