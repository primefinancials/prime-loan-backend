        "@types/crypto-js": "^4.2.2",
        "@types/express": "^4.17.23",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^2.0.0",
        "@types/node": "^18.15.11",
