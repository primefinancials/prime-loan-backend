# ============================================================================
#  Prime Loan Backend — STAGING env template for the new eu-west-1 EB env.
#
#  HOW TO USE
#  1. Copy every value from the CURRENT staging environment:
#       AWS Console (us-east-1) -> Elastic Beanstalk -> Environments
#       -> prime-finance-staging-env -> Configuration
#       -> "Updates, monitoring, and logging" -> Edit -> Environment properties
#  2. Fill the values below.
#  3. Save this file as:  .env.staging   (that name IS gitignored + ebignored)
#  4. Tell Claude it's ready — it loads these into the new EB env, never commits them.
#
#  Leave a line blank/unchanged if the current staging env does not set it.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
# IMPORTANT: copy EXACTLY what the current staging env uses. If it is "dev",
# the app reads the *_staging MongoDB collections; the new box must match.
NODE_ENV=
ENV=
PORT=8080
LOG_LEVEL=info
LOG_DIRECTORY=/var/app/current/logs

# --- Database (MongoDB Atlas — unchanged, same cluster) ---------------------
DB_URL=
DATABASE_NAME=
MONGODB_URI=
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# --- Redis (co-located on the EB instance — Claude sets this) --------------
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security --------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
CRYPTOJS_KEY=
EMAIL_VERIFICATION_CODE_EXPIRES_IN=

# --- Frontend / CORS -----------------------------------------------------------
# Staging user-app URL (Vercel). Claude also sets CORS_ORIGINS from this + admin.
FRONTEND_URL=
NEXT_PUBLIC_APP_URL=
CORS_ORIGINS=

# --- Mono (Direct Debit) --------------------------------------------------------
MONO_BASE_URL=https://api.withmono.com
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=
MONO_WEBHOOK_SECRET=
# Set to 'true' ONLY on staging if you want to bypass the account-name match check
MONO_SKIP_NAME_MATCH=

# --- Flutterwave -------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# --- Monnify --------------------------------------------------------------------
MONNIFY_BASE_URL=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# --- OPay ---------------------------------------------------------------------
OPAY_MERCHANT_ID=
OPAY_SECRET_KEY=
OPAY_PUBLIC_KEY=

# --- VFD (banking / transfers) ----------------------------------------------
CUSTOMER_KEY=
CUSTOMER_SECRET=
BASE_URL=
AUTH_URL=

# --- Cloudinary (media) ----------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- S3 (image storage) ----------------------------------------------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (SMTP) --------------------------------------------------------------
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT_NUMBER=
EMAIL_INTERVAL=

# --- PayBeta (bill payments) ----------------------------------------------
PAYBETA_API_KEY=
PAYBETA_API_URL=https://api.paybeta.ng/v2

# --- ClubConnect (bill payments) ------------------------------------------
CLUB_KONNECT_API_KEY=
CLUB_KONNECT_API_USER_ID=
CLUB_KONNECT_API_URL=

# --- Voice / SMS ------------------------------------------------------------
VOICE_CALL_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=PrimeFinance
AT_USERNAME=
AT_API_KEY=
AT_VOICE_CALLBACK_URL=
AT_CALL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=

# --- Loan / worker config ---------------------------------------------------
LOAN_AUTO_APPROVAL_MAX_KOBO=5000000
LOAN_PENALTY_PCT_PER_DAY=1
AUTO_DEBIT_RETRY_SCHEDULE=3600000,21600000,86400000
POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=100
REFUND_TIMEOUT_MS=86400000

# --- Feature flags ---------------------------------------------------------
FEATURE_LEDGER=true
FEATURE_AUTO_APPROVAL=true
FEATURE_OCR=true

